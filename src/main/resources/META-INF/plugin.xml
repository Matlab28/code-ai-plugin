<idea-plugin url="https://github.com/Matlab28/code-ai-plugin">
    <id>com.codeai.reviewer</id>
    <name>CodeAI Reviewer</name>
    <vendor email="metleb.abbaszade@gmail.com" url="https://github.com/Matlab28">Matlab Abbaszada</vendor>
    <description><![CDATA[
        <p>Reviews uncommitted Git changes using OpenRouter, another OpenAI-compatible AI service, or a configurable Spring Boot backend.</p>
        <p>Includes secret filtering, <code>.codeaiignore</code>, structured findings, and source navigation.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="CodeAI Reviewer" anchor="right" icon="/icons/codeai.svg"
                    factoryClass="com.codeai.reviewer.ui.CodeAiToolWindowFactory"/>
        <applicationConfigurable id="com.codeai.reviewer.settings"
                                 displayName="CodeAI Reviewer"
                                 parentId="tools"
                                 instance="com.codeai.reviewer.settings.CodeAiConfigurable"/>
    </extensions>

    <actions>
        <group id="CodeAi.Menu" text="CodeAI" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="CodeAi.ReviewChanges"
                    class="com.codeai.reviewer.action.ReviewChangesAction"
                    text="Review Changes"
                    description="Review uncommitted changes with CodeAI"/>
        </group>
    </actions>
</idea-plugin>
